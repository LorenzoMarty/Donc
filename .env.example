# Copie para .env e preencha os valores reais. NUNCA commite .env com valores reais.

# Banco de dados
POSTGRES_DB=enem_redacao
POSTGRES_USER=enem
POSTGRES_PASSWORD=TROQUE_AQUI
DATABASE_URL=postgresql+psycopg://enem:TROQUE_AQUI@db:5432/enem_redacao

# Segurança — gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=TROQUE_AQUI

# IA (OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1

# Deixe false em produção
SEED_DEMO_DATA=false

# Opcional — telemetria Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
