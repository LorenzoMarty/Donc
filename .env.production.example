# Copie para .env.production NO VPS (nunca commite). Usado pelo compose (--env-file) e pelos
# containers backend/worker. Gere segredos com: python -c "import secrets; print(secrets.token_hex(32))"
DOMAIN=app.exemplo.com.br

POSTGRES_DB=donc
POSTGRES_USER=donc
POSTGRES_PASSWORD=TROQUE_AQUI

JWT_SECRET_KEY=TROQUE_AQUI
FRONTEND_ORIGIN=https://app.exemplo.com.br
SEED_ADMIN_PASSWORD=TROQUE_AQUI

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM="Donc <nao-responda@exemplo.com.br>"

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Monitoramento (Sentry free: um projeto para o backend/worker, outro para o frontend). Vazio = desligado.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Cloudflare Turnstile (captcha invisivel no cadastro e na recuperacao de senha). Sem as duas chaves, fica desligado.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Backup off-site (deploy/backup.sh): remote do rclone, ex. "b2:donc-backups". Vazio = so local.
BACKUP_RCLONE_REMOTE=
