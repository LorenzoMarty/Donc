{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "app/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/index.py"
    }
  ],
  "functions": {
    "app/index.py": {
      "maxDuration": 60
    }
  }
}
